# Telegram API credentials from https://my.telegram.org
TELEGRAM_API_ID=YOUR_API_ID
TELEGRAM_API_HASH=YOUR_API_HASH

# Make these long random secrets; do not share them.
PANEL_PASSWORD=CHANGE_TO_A_LONG_UNIQUE_PASSWORD
SECRET_KEY=CHANGE_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DB_PATH=./data/panel.db
TELEGRAM_SESSION_PATH=./data/telegram_user
# Set true only when serving behind HTTPS:
COOKIE_SECURE=false
